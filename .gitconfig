[user]
	name = Michael Andreas Troute
	email = michael.troute@gmail.com
	signingkey = /Users/mtroute/.ssh/id_ed25519.pub
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
[merge]
	conflictstyle = zdiff3
[gpg]
	format = ssh
[commit]
	gpgsign = true
[alias]
	a = add
	b = branch
    c = commit
    cnv = commit --no-verify
	co = checkout
	d = diff
	f = fetch
	l = log
	p = pull
	ps = push
    psnv = push --no-verify
	r = rebase
	s = status
	m = merge
	st = stash
