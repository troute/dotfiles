{
  "env": {
    "ZDOTDIR": "/Users/mtroute/.claude/zsh"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux set-option -p -t \"$TMUX_PANE\" @claude_pane 'working' 2>/dev/null; tmux set-option -w -t \"$TMUX_PANE\" @claude_status 'working' 2>/dev/null; true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux set-option -p -t \"$TMUX_PANE\" @claude_pane 'working' 2>/dev/null; tmux set-option -w -t \"$TMUX_PANE\" @claude_status 'working' 2>/dev/null; true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux set-option -p -t \"$TMUX_PANE\" @claude_pane 'stopped' 2>/dev/null; tmux set-option -w -t \"$TMUX_PANE\" @claude_status 'stopped' 2>/dev/null; true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux set-option -p -t \"$TMUX_PANE\" @claude_pane 'stopped' 2>/dev/null; tmux set-option -w -t \"$TMUX_PANE\" @claude_status 'stopped' 2>/dev/null; true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux set-option -p -t \"$TMUX_PANE\" @claude_pane 'working' 2>/dev/null; tmux set-option -w -t \"$TMUX_PANE\" @claude_status 'working' 2>/dev/null; true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux set-option -pu -t \"$TMUX_PANE\" @claude_pane 2>/dev/null; tmux set-option -wu -t \"$TMUX_PANE\" @claude_status 2>/dev/null; true"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "verbose": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
